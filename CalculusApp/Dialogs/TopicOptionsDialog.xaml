<Window x:Class="CalculusApp.Dialogs.TopicOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Applications of Differentiation - Absolute Extrema" 
        Height="730" Width="1080"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ThemeWindowBackground}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="Segoe UI"
        FontSize="13.5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Top Controls Bar -->
            <RowDefinition Height="*"/>      <!-- Main Split: Options (Left) & Preview (Right) -->
        </Grid.RowDefinitions>

        <!-- 1. Top Controls Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- Number of questions -->
                <ColumnDefinition Width="Auto"/>  <!-- Input Box -->
                <ColumnDefinition Width="Auto"/>  <!-- Action Buttons -->
                <ColumnDefinition Width="*"/>     <!-- Spacing -->
                <ColumnDefinition Width="Auto"/>  <!-- More Samples link -->
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="NumQuestionsLabel" Text="Number of questions:" VerticalAlignment="Center" 
                       Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13.8" Margin="0,0,8,0" FontWeight="SemiBold"/>
            
            <TextBox Grid.Column="1" x:Name="NumQuestionsBox" Text="4" Width="46" Height="32" VerticalContentAlignment="Center" 
                     HorizontalContentAlignment="Center" Margin="0,0,14,0" TextChanged="OnNumQuestionsChanged"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource AppAccentBtn}" MinWidth="80" Height="32" 
                        IsDefault="True" Click="OnOkClick" Margin="0,0,8,0"/>
                <Button x:Name="AddContinueButton" Content="Add &amp; Continue" Style="{StaticResource AppBtn}" MinWidth="136" Height="32" 
                        Click="OnAddContinueClick" Margin="0,0,8,0"/>
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource AppBtn}" MinWidth="85" Height="32" 
                        IsCancel="True" Click="OnCancelClick"/>
            </StackPanel>

            <!-- More Samples link -->
            <Button Grid.Column="4" x:Name="MoreSamplesBtn" Content="More samples" Cursor="Hand" VerticalAlignment="Center" 
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeAccent}" FontSize="13.8" FontWeight="SemiBold" 
                    Click="OnMoreSamplesClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" 
                                   TextDecorations="Underline"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 2. Main 2-Column Split: Parameters Left, Live Preview Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470"/>  <!-- Left: Options & Parameters -->
                <ColumnDefinition Width="16"/>   <!-- Split spacing -->
                <ColumnDefinition Width="*"/>    <!-- Right: Paper Preview Card -->
            </Grid.ColumnDefinitions>

            <!-- Left: Options ScrollViewer -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <!-- Preset choices -->
                    <GroupBox x:Name="PresetGroupBox" Header="Preset choices">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                            <Button x:Name="EasyBtn" Content="Easy" Style="{StaticResource PresetBtn}" Click="OnPresetEasyClick"/>
                            <Button x:Name="MediumBtn" Content="Medium" Style="{StaticResource PresetBtn}" Click="OnPresetMediumClick"/>
                            <Button x:Name="HardBtn" Content="Hard" Style="{StaticResource PresetBtn}" Click="OnPresetHardClick"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Question type -->
                    <GroupBox x:Name="QuestionTypeGroupBox" Header="Question type">
                        <StackPanel Orientation="Horizontal" Margin="4,4,0,4">
                            <RadioButton x:Name="FreeResponseRadio" Content="Free response" IsChecked="True" 
                                         Checked="OnQuestionTypeChanged" Margin="0,0,32,0"/>
                            <RadioButton x:Name="MultipleChoiceRadio" Content="Multiple choice" 
                                         Checked="OnQuestionTypeChanged"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Options -->
                    <GroupBox x:Name="OptionsGroupBox" Header="Options">
                        <StackPanel Margin="4,2,0,2">
                            <!-- Notation -->
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <TextBlock x:Name="NotationLabel" Text="Notation: " VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,10,0"/>
                                <RadioButton x:Name="NotationYRadio" Content="y =" IsChecked="True" Checked="OnNotationChanged" Margin="0,0,16,0"/>
                                <RadioButton x:Name="NotationFxRadio" Content="f(x) =" Checked="OnNotationChanged" Margin="0,0,16,0"/>
                                <RadioButton x:Name="NotationEitherRadio" Content="Either" Checked="OnNotationChanged"/>
                            </StackPanel>

                            <!-- Checkbox Options -->
                            <CheckBox x:Name="VaryLettersCheck" Content="Vary letters for functions and variables" Checked="OnOptionToggled" Unchecked="OnOptionToggled"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <CheckBox x:Name="BlankGraphCheck" Content="Provide a blank graph" Margin="0,0,20,0" Checked="OnOptionToggled" Unchecked="OnOptionToggled"/>
                                <CheckBox x:Name="FunctionGraphCheck" Content="Provide a graph of the function" Checked="OnOptionToggled" Unchecked="OnOptionToggled"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Complexity (Adaptive per topic) -->
                    <GroupBox x:Name="ComplexityGroupBox" Header="Complexity">
                        <StackPanel Margin="4,2,0,2">
                            <TextBlock x:Name="ComplexityPrompt" Text="For each problem, find all points of absolute extrema over:" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" Margin="0,2,0,6" TextWrapping="Wrap"/>
                            
                            <!-- Interval / Method Radio Group -->
                            <StackPanel Margin="2,0,0,8">
                                <RadioButton x:Name="ComplexityRadio1" Content="A closed interval" IsChecked="True" Checked="OnComplexityRadioChanged"/>
                                <RadioButton x:Name="ComplexityRadio2" Content="An open interval" Checked="OnComplexityRadioChanged"/>
                                <RadioButton x:Name="ComplexityRadio3" Content="A half open interval" Checked="OnComplexityRadioChanged"/>
                                <RadioButton x:Name="ComplexityRadio4" Content="An interval involving infinity" Checked="OnComplexityRadioChanged"/>
                                <RadioButton x:Name="ComplexityRadio5" Content="Any" Checked="OnComplexityRadioChanged"/>
                            </StackPanel>

                            <!-- Functions Subheader -->
                            <TextBlock x:Name="FunctionsSubheader" Text="Functions:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,4,0,4"/>
                            
                            <!-- 2-Column Checkbox Grid -->
                            <Grid Margin="2,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <CheckBox x:Name="FuncCheck1" Content="Quadratic" IsChecked="True" Checked="OnFuncCheckChanged" Unchecked="OnFuncCheckChanged"/>
                                    <CheckBox x:Name="FuncCheck2" Content="Cubic" Checked="OnFuncCheckChanged" Unchecked="OnFuncCheckChanged"/>
                                    <CheckBox x:Name="FuncCheck3" Content="Quartic" Checked="OnFuncCheckChanged" Unchecked="OnFuncCheckChanged"/>
                                    <CheckBox x:Name="FuncCheck4" Content="Rational" Checked="OnFuncCheckChanged" Unchecked="OnFuncCheckChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <CheckBox x:Name="FuncCheck5" Content="Rational exponent, easy" Checked="OnFuncCheckChanged" Unchecked="OnFuncCheckChanged"/>
                                    <CheckBox x:Name="FuncCheck6" Content="Rational exponent, hard" Checked="OnFuncCheckChanged" Unchecked="OnFuncCheckChanged"/>
                                    <CheckBox x:Name="FuncCheck7" Content="Simple trigonometric" Checked="OnFuncCheckChanged" Unchecked="OnFuncCheckChanged"/>
                                    <CheckBox x:Name="FuncCheck8" Content="Exponential" Visibility="Collapsed" Checked="OnFuncCheckChanged" Unchecked="OnFuncCheckChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: Paper Preview Card -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Direction Header -->
                    <RowDefinition Height="*"/>     <!-- White Sheet of Paper Preview -->
                </Grid.RowDefinitions>

                <!-- Direction Header -->
                <TextBlock Grid.Row="0" x:Name="PreviewDirectionHeader" 
                           Text="For each problem, find all points of absolute minima and maxima on the given interval." 
                           Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12.5" FontWeight="SemiBold" 
                           Margin="0,0,0,8" TextWrapping="Wrap"/>

                <!-- White Paper Card -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="3" Opacity="0.15" Color="#000000"/>
                    </Border.Effect>

                    <ScrollViewer x:Name="SamplesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SamplesContainer" Margin="4">
                            <!-- Live Generated Questions rendered with LaTeX & Red Teacher Answers -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
