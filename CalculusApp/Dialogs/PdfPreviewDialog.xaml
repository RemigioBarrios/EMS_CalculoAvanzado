<Window x:Class="CalculusApp.Dialogs.PdfPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CalculusApp.Controls"
        Title="Vista Previa de PDF - Infinite Calculus" 
        Height="840" Width="1160"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBackground}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Controls Bar -->
        <Border Grid.Row="0" Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="0,0,0,1" Padding="8,6,8,6">
            <DockPanel LastChildFill="False">
                <!-- Left Section: Document title & Sidebar toggle -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="ToggleThumbnailsBtn" Style="{StaticResource ToggleToolBtn}" IsChecked="True" 
                                  ToolTip="Mostrar / Ocultar barra de miniaturas" Click="OnToggleThumbnailsClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼️" Margin="0,0,4,0"/>
                            <TextBlock Text="Miniaturas"/>
                        </StackPanel>
                    </ToggleButton>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource ThemeBorderSubtle}" Margin="8,0,8,0"/>

                    <!-- Page Navigation -->
                    <Button x:Name="PrevPageBtn" Style="{StaticResource ToolBtn}" ToolTip="Página anterior (RePág)" Click="OnPrevPageClick">
                        <TextBlock Text="◀"/>
                    </Button>

                    <Border Background="{DynamicResource ThemeControlBackground}" BorderBrush="{DynamicResource ThemeControlBorder}" BorderThickness="1" CornerRadius="4" Margin="4,0,4,0" Padding="10,4,10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="PageIndicatorText" Text="Página 1 de 1" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="Bold"/>
                    </Border>

                    <Button x:Name="NextPageBtn" Style="{StaticResource ToolBtn}" ToolTip="Página siguiente (AvPág)" Click="OnNextPageClick">
                        <TextBlock Text="▶"/>
                    </Button>
                </StackPanel>

                <!-- Center Section: Zoom controls -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button x:Name="ZoomOutBtn" Style="{StaticResource ToolBtn}" ToolTip="Reducir zoom (Ctrl -)" Click="OnZoomOutClick">
                        <TextBlock Text="➖" FontSize="10"/>
                    </Button>

                    <ComboBox x:Name="ZoomPresetCombo" Width="145" Height="28" VerticalContentAlignment="Center" Margin="4,0,4,0"
                              SelectionChanged="OnZoomPresetChanged">
                        <ComboBoxItem Content="Ajustar al Ancho" IsSelected="True"/>
                        <ComboBoxItem Content="Página Completa"/>
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="125%"/>
                        <ComboBoxItem Content="150%"/>
                        <ComboBoxItem Content="200%"/>
                    </ComboBox>

                    <Button x:Name="ZoomInBtn" Style="{StaticResource ToolBtn}" ToolTip="Aumentar zoom (Ctrl +)" Click="OnZoomInClick">
                        <TextBlock Text="➕" FontSize="10"/>
                    </Button>

                    <Border Background="{DynamicResource ThemeControlBackground}" BorderBrush="{DynamicResource ThemeControlBorder}" BorderThickness="1" CornerRadius="4" Margin="6,0,4,0" Padding="8,4,8,4" VerticalAlignment="Center" ToolTip="Nivel de zoom actual">
                        <TextBlock x:Name="ZoomPercentLabel" Text="100%" Foreground="{DynamicResource ThemeAccent}" FontSize="12" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Right Section: Action Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SavePdfBtn" Style="{StaticResource AppAccentBtn}" Click="OnSavePdfClick" ToolTip="Guardar documento como archivo PDF (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,5,0"/>
                            <TextBlock Text="Guardar PDF..."/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PrintBtn" Style="{StaticResource AppBtn}" Margin="6,0,6,0" Click="OnPrintClick" ToolTip="Imprimir documento (Ctrl+P)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Margin="0,0,5,0"/>
                            <TextBlock Text="Imprimir..."/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CloseBtn" Style="{StaticResource ToolBtn}" Click="OnCloseClick" ToolTip="Cerrar vista previa (Esc)">
                        <TextBlock Text="✖ Cerrar"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Main Work Area (Sidebar + Document Viewport) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ThumbnailsCol" Width="200" MinWidth="140" MaxWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Thumbnails Panel -->
            <Border Grid.Column="0" x:Name="ThumbnailsBorder" Background="{DynamicResource ThemeSidebarBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeHeaderBackground}" Padding="10,8,10,8" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="ThumbnailsHeader" Text="PÁGINAS DEL DOCUMENTO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ThumbnailsContainer" Margin="10,12,10,12">
                            <!-- Page thumbnail items will be populated dynamically -->
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Splitter between thumbnails and viewport -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ThemeSplitter}" ShowsPreview="False"/>

            <!-- Right: Document Viewport with WorksheetView -->
            <Border Grid.Column="2" Background="{DynamicResource ThemeCanvasBackground}">
                <controls:WorksheetView x:Name="PreviewWorksheetView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="0,1,0,0" Padding="12,5,12,5">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusInfoText" DockPanel.Dock="Left" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" 
                           Text="Modo: Vectorial de alta fidelidad | 8.5 x 11.0 pulg (Carta) | Use la rueda del mouse con Ctrl para hacer zoom"/>
                <TextBlock x:Name="StatusDocTitle" DockPanel.Dock="Right" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" FontWeight="SemiBold" Text="Infinite Calculus"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
