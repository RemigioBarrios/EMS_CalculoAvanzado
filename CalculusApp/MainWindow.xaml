                <MenuItem Header="Exportar a INI / TXT (Formato Plano)..." Command="{Binding ExportIniCommand}" Visibility="{Binding TeacherOrInstituteVisibility}"/>
                <MenuItem Header="Importar desde INI / TXT..." Command="{Binding ImportIniCommand}" Visibility="{Binding TeacherOrInstituteVisibility}"/>
                <Separator/>
                <MenuItem Header="📝 Estudio de Manipulación Markdown (.md)..." Command="{Binding OpenMarkdownStudioCommand}"/>
                <MenuItem Header="📂 Abrir / Importar Evaluación Markdown (.md)..." Command="{Binding ImportMarkdownCommand}"/>
                <MenuItem Header="💾 Guardar Evaluación como Markdown (.md)..." Command="{Binding ExportMarkdownCommand}"/>
                <Separator/>
