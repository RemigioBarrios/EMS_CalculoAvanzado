        <!-- ================= 5. COLLAPSIBLE THREE-COLUMN MAIN WORKSPACE ================= -->
        <Grid Background="{DynamicResource ThemeWindowBackground}">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Collapsed Left Dock Tab Strip (Visible when Left Sidebar is closed) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Column 1: Left Sidebar (Topics & Active Series Explorer) -->
                <ColumnDefinition x:Name="LeftSidebarCol" Width="325" MinWidth="250" MaxWidth="520"/>
                <!-- Column 2: Left Splitter -->
                <ColumnDefinition x:Name="LeftSplitterCol" Width="5"/>
                <!-- Column 3: Center (Worksheet Canvas / Markdown Studio) -->
                <ColumnDefinition x:Name="CenterWorkspaceCol" Width="*" MinWidth="450"/>
                <!-- Column 4: Right Splitter -->
                <ColumnDefinition x:Name="RightSplitterCol" Width="5"/>
                <!-- Column 5: Right Sidebar (Asistente IA / Miniaturas) -->
                <ColumnDefinition x:Name="RightSidebarCol" Width="415" MinWidth="280" MaxWidth="680"/>
                <!-- Column 6: Collapsed Right Dock Tab Strip (Visible when Right Sidebar is closed) -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ================= COLUMN 0: COLLAPSED LEFT DOCK STRIP ================= -->
            <Border Grid.Column="0" x:Name="LeftCollapsedStrip" Visibility="Collapsed"
                    Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="4,8">
                <Button Style="{StaticResource ToolBtn}" Command="{Binding ToggleLeftSidebarCommand}"
                        ToolTip="Abrir Panel Lateral de Temas y Series Activas" Padding="6,12" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="▶" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="T&#x0a;E&#x0a;M&#x0a;A&#x0a;S" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- ================= COLUMN 1: LEFT SIDEBAR (TOPICS & SERIES EXPLORER) ================= -->
            <Border Grid.Column="1" x:Name="LeftSidebarBorder" Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>                                <!-- 0: Header: TEMAS + Close Button -->
                        <RowDefinition Height="Auto"/>                                <!-- 1: Search & Filter Toolbar -->
                        <RowDefinition x:Name="TopicsTreeRow" Height="3.6*" MinHeight="140"/> <!-- 2: Topics TreeView -->
                        <RowDefinition x:Name="SeriesSplitterRow" Height="Auto"/>     <!-- 3: Horizontal Splitter -->
                        <RowDefinition x:Name="SeriesActivasRow" Height="2*" MinHeight="165"/> <!-- 4: Question Sets Panel -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Left Sidebar Header with Close Button (◀ Ocultar) -->
                    <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="10,7,8,7">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolBtn}" Command="{Binding ToggleLeftSidebarCommand}"
                                    ToolTip="Ocultar ventana lateral de Temas y Series" Padding="8,2" MinHeight="26" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◀ " FontSize="11.5" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ocultar" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding LeftSidebarHeader}"
                                       FontWeight="Bold"
                                       FontSize="13.8"
                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <!-- Row 1: Action & Search Toolbar (Larger Buttons & Input) -->
                    <Border Grid.Row="1" Background="{DynamicResource ThemeControlBackground}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="0,0,0,1" Padding="6,5,6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sort 12↓ -->
                            <Button Grid.Column="0" Style="{StaticResource ToolBtn}" Command="{Binding ToggleSortTopicsCommand}" ToolTip="Ordenar Alfabético / Natural" Width="32" Height="28" Padding="0" Margin="0,0,2,0">
                                <TextBlock Text="12↓" FontSize="12" FontWeight="Bold"/>
                            </Button>

                            <!-- Expand / Collapse + -->
                            <Button Grid.Column="1" Style="{StaticResource ToolBtn}" ToolTip="Expandir / Colapsar Todas las Categorías" Width="30" Height="28" Padding="0" Margin="0,0,4,0" Click="OnToggleExpandAllClick">
                                <TextBlock Text="±" FontSize="14.5" FontWeight="Bold"/>
                            </Button>

                            <!-- Label Buscar -->
                            <TextBlock Grid.Column="2" Text="🔍" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" Margin="2,0,5,0"/>

                            <!-- Search Input Box -->
                            <TextBox Grid.Column="3"
                                     x:Name="SearchBox"
                                     Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource ThemePanelBackground}"
                                     Foreground="{DynamicResource ThemeTextPrimary}"
                                     CaretBrush="{DynamicResource ThemeAccent}"
                                     BorderBrush="{DynamicResource ThemeBorder}"
                                     BorderThickness="1"
                                     Padding="6,0,6,0"
                                     FontSize="13.5"
                                     ToolTip="Buscar tema o categoría por nombre"/>

                            <!-- Folder Dropdown 📁▼ -->
                            <Button Grid.Column="4" Style="{StaticResource ToolBtn}" ToolTip="Cambiar Materia / Cargar Temario" Width="34" Height="28" Padding="0" Margin="4,0,0,0" Click="OnFolderDropdownClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="13.5"/>
                                    <TextBlock Text="▾" FontSize="10" Margin="2,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 2: Topics TreeView (Larger, Clearer Typography) -->
                    <TreeView Grid.Row="2"
                              x:Name="TopicsTree"
                              ItemsSource="{Binding TopicCategories}"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="4,6,4,6"
                              SelectedItemChanged="OnTopicTreeSelectedItemChanged"
                              MouseDoubleClick="OnTopicTreeDoubleClick">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Padding" Value="4,3,4,3"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeAccentLight}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,2,2,2" VerticalAlignment="Center">
                                    <!-- Category icon -->
                                    <Border Width="14" Height="14"
                                            BorderBrush="{DynamicResource ThemeAccent}"
                                            BorderThickness="1.5"
                                            Background="{DynamicResource ThemeControlBackground}"
                                            CornerRadius="3"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Prefix on subtopics -->
                                    <TextBlock Text="• " Foreground="{DynamicResource ThemeAccent}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Item Title -->
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="13.5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                        <Setter Property="FontSize" Value="14"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCategory}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Row 3: Horizontal Splitter between Topics and Question Sets -->
                    <GridSplitter Grid.Row="3" x:Name="SeriesGridSplitter" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="{DynamicResource ThemeBorder}" Cursor="SizeNS" ResizeDirection="Rows"/>

                    <!-- Row 4: Active Question Sets Panel (Collapsible & Resizable, Larger Buttons) -->
                    <Border Grid.Row="4" Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header + Action Buttons -->
                                <RowDefinition Height="*"/>    <!-- Scrollable QuestionSets List -->
                            </Grid.RowDefinitions>

                            <!-- Question Sets Header & Toolbar -->
                            <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="0,0,0,1" Padding="8,5,6,5">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ToolBtn}" Command="{Binding MoveUpCommand}" ToolTip="Mover serie arriba (▲)" Width="28" Height="26" Padding="0" Margin="1,0">
                                            <TextBlock Text="▲" FontSize="11.5" Foreground="{DynamicResource ThemeAccent}"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolBtn}" Command="{Binding MoveDownCommand}" ToolTip="Mover serie abajo (▼)" Width="28" Height="26" Padding="0" Margin="1,0">
                                            <TextBlock Text="▼" FontSize="11.5" Foreground="{DynamicResource ThemeAccent}"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolBtn}" Command="{Binding EditQuestionSetCommand}" ToolTip="Editar opciones de serie (Parámetros, cantidad, tipo) (⚙)" Width="28" Height="26" Padding="0" Margin="1,0">
                                            <TextBlock Text="⚙" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolBtn}" Command="{Binding EditQuestionsDirectlyCommand}" ToolTip="Editar preguntas y soluciones directamente (✏)" Width="28" Height="26" Padding="0" Margin="1,0">
                                            <TextBlock Text="✏" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolBtn}" Command="{Binding EditSetMarkdownCommand}" ToolTip="Manipular, editar y guardar esta serie en formato Markdown (.md) (📝)" Width="28" Height="26" Padding="0" Margin="1,0">
                                            <TextBlock Text="📝" FontSize="12.5" Foreground="#7C3AED"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolBtn}" Command="{Binding RegenerateSetCommand}" ToolTip="Regenerar serie de preguntas (🔄)" Width="28" Height="26" Padding="0" Margin="1,0">
                                            <TextBlock Text="🔄" FontSize="12" Foreground="#10B981"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolBtn}" Command="{Binding RemoveQuestionSetCommand}" ToolTip="Eliminar serie de la evaluación (✕)" Width="28" Height="26" Padding="0" Margin="1,0">
                                            <TextBlock Text="✕" FontSize="12.5" FontWeight="Bold" Foreground="#E11D48"/>
                                        </Button>
                                        <!-- Collapse / Expand Series Panel Button -->
                                        <Button Style="{StaticResource ToolBtn}" Command="{Binding ToggleSeriesPanelCommand}" ToolTip="Contraer o expandir el panel de Series Activas" Width="26" Height="26" Padding="0" Margin="3,0,0,0">
                                            <TextBlock Text="{Binding SeriesPanelExpandIcon}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Left Title + Badge -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📋 " FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="SERIES" FontWeight="Bold" FontSize="12.8" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding QuestionSetsSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextMuted}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- QuestionSets ListBox -->
                            <ListBox Grid.Row="1"
                                     x:Name="QuestionSetsListBox"
                                     ItemsSource="{Binding QuestionSets}"
                                     SelectedItem="{Binding SelectedQuestionSet}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource ThemeTextPrimary}"
                                     BorderThickness="0"
                                     Padding="4"
                                     MouseDoubleClick="OnQuestionSetDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,5,6,5"/>
                                        <Setter Property="Margin" Value="1,2,1,2"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeAccentLight}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="4,2,4,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Left"
                                                        Style="{StaticResource ToolBtn}"
                                                        Command="{Binding DataContext.ToggleHideItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Width="24" Height="24" Padding="0" Margin="0,0,6,0"
                                                        ToolTip="Ocultar / Mostrar esta serie en la hoja">
                                                    <TextBlock Text="{Binding VisibilityIcon}" FontSize="12"/>
                                                </Button>

                                                <Border DockPanel.Dock="Right" Background="{DynamicResource ThemeControlBackground}"
                                                        BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1"
                                                        CornerRadius="8" Padding="7,2,7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Questions.Count, StringFormat='{}{0} preg'}"
                                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                </Border>

                                                <TextBlock Text="{Binding TopicTitle}" FontWeight="SemiBold" FontSize="13.2"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu FontSize="13">
                                        <MenuItem Header="⚙ Editar opciones del tema (Parámetros)..." Command="{Binding EditQuestionSetCommand}"/>
                                        <MenuItem Header="✏ Editar preguntas directamente (LaTeX / Texto)..." Command="{Binding EditQuestionsDirectlyCommand}"/>
                                        <MenuItem Header="📝 Manipular y editar serie en Markdown (.md)..." Command="{Binding EditSetMarkdownCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="👁 Ocultar / Mostrar serie" Command="{Binding ToggleHideSetCommand}"/>
                                        <MenuItem Header="▲ Mover arriba" Command="{Binding MoveUpCommand}"/>
                                        <MenuItem Header="▼ Mover abajo" Command="{Binding MoveDownCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="🔄 Regenerar serie aleatoria" Command="{Binding RegenerateSetCommand}"/>
                                        <MenuItem Header="✕ Eliminar serie de la evaluación" Command="{Binding RemoveQuestionSetCommand}"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 2: Left Splitter -->
            <GridSplitter Grid.Column="2" x:Name="LeftGridSplitter" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ThemeBorder}" Cursor="SizeWE"/>

            <!-- ================= COLUMN 3: CENTER WORKSHEET CANVAS & MARKDOWN WORKSPACE ================= -->
            <Grid Grid.Column="3" Background="{DynamicResource ThemeCanvasBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Center Toolbar -->
                    <RowDefinition Height="*"/>      <!-- Worksheet Canvas / Markdown Editor -->
                </Grid.RowDefinitions>

                <!-- Center Workspace Toolbar (Larger Buttons & Clear Grouping) -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,5,8,5">
                    <DockPanel LastChildFill="False">
                        <WrapPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <!-- 💾 Save -->
                            <Button Style="{StaticResource ToolBtn}" Command="{Binding SaveCommand}" ToolTip="Guardar (Ctrl+S)" Width="34" Height="30" Margin="1,0">
                                <TextBlock Text="💾" FontSize="14.5"/>
                            </Button>
                            <!-- 🖨️ Print -->
                            <Button Style="{StaticResource ToolBtn}" Command="{Binding PrintCommand}" ToolTip="Imprimir (Ctrl+P)" Width="34" Height="30" Margin="1,0">
                                <TextBlock Text="🖨️" FontSize="14.5"/>
                            </Button>
                            <!-- 🔍+ Zoom In -->
                            <Button Style="{StaticResource ToolBtn}" Command="{Binding ZoomInCommand}" ToolTip="Acercar (Zoom In)" Width="36" Height="30" Margin="1,0">
                                <TextBlock Text="🔍+" FontSize="13" FontWeight="SemiBold"/>
                            </Button>
                            <!-- 🔍- Zoom Out -->
                            <Button Style="{StaticResource ToolBtn}" Command="{Binding ZoomOutCommand}" ToolTip="Alejar (Zoom Out)" Width="36" Height="30" Margin="1,0">
                                <TextBlock Text="🔍-" FontSize="13" FontWeight="SemiBold"/>
                            </Button>
                            <!-- <> Fit / Reset -->
                            <Button Style="{StaticResource ToolBtn}" Command="{Binding ResetZoomCommand}" ToolTip="Restablecer Zoom 100%" Height="30" Padding="8,2" Margin="1,0">
                                <TextBlock Text="100%" FontSize="12.5" FontWeight="Bold"/>
                            </Button>

                            <!-- Document Mode Switcher (Modo Examen | Modo PDF | Modo Markdown) -->
                            <Border Background="{DynamicResource ThemeControlBackground}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="5" Padding="2" Margin="8,0,4,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentedRadioBtn}" Content="Modo Examen" FontSize="13.2" Padding="10,4"
                                                 IsChecked="{Binding IsExamMode}"
                                                 ToolTip="Vista continua interactiva tipo examen impreso"/>
                                    <RadioButton Style="{StaticResource SegmentedRadioBtn}" Content="Modo PDF" FontSize="13.2" Padding="10,4"
                                                 IsChecked="{Binding IsPdfMode}"
                                                 ToolTip="Vista paginada estándar formato carta / A4"/>
                                    <RadioButton Style="{StaticResource SegmentedRadioBtn}" Content="📝 Modo Markdown" FontSize="13.2" Padding="10,4"
                                                 IsChecked="{Binding IsMarkdownMode}"
                                                 ToolTip="Manipular, editar y guardar la evaluación directamente en formato Markdown (.md)"/>
                                </StackPanel>
                            </Border>

                            <!-- Quick Markdown Studio Dialog Button -->
                            <Button Style="{StaticResource ToolBtn}" Command="{Binding OpenMarkdownStudioCommand}" ToolTip="Abrir Estudio de Edición Markdown (.md) en Ventana Completa" Height="30" Padding="9,3" Margin="2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝 " FontSize="13"/>
                                    <TextBlock Text=".md" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Column Switcher (1 Col | 2 Col) -->
                            <Border Background="{DynamicResource ThemeControlBackground}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="5" Padding="2" Margin="4,0,8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentedRadioBtn}" Content="1 Col" FontSize="13.2" Padding="10,4"
                                                 IsChecked="{Binding IsSingleColumn}"
                                                 ToolTip="Organizar ejercicios en 1 columna continua"/>
                                    <RadioButton Style="{StaticResource SegmentedRadioBtn}" Content="2 Col" FontSize="13.2" Padding="10,4"
                                                 IsChecked="{Binding IsTwoColumns}"
                                                 ToolTip="Organizar ejercicios en 2 columnas paralelas"/>
                                </StackPanel>
                            </Border>

                            <!-- Status label -->
                            <TextBlock Text="{Binding CenterStatusLabel}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextSecondary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="4,0,0,0"/>
                        </WrapPanel>

                        <!-- Right Actions: Show Answers & Regenerate -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource ToggleToolBtn}" IsChecked="{Binding ShowAnswers}" ToolTip="Mostrar u Ocultar Respuestas" Height="30" Padding="10,4" Margin="2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👁️ " FontSize="13"/>
                                    <TextBlock Text="Respuestas" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ToggleButton>
                            <Button Style="{StaticResource ToolBtn}" Command="{Binding RegenerateAllCommand}" ToolTip="Regenerar Todos los Ejercicios (F5)" Height="30" Padding="10,4" Margin="2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄 " FontSize="13" Foreground="#007ACC"/>
                                    <TextBlock Text="Regenerar" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Central Worksheet Canvas & Embedded Markdown Workspace -->
                <Border Grid.Row="1" Background="{DynamicResource ThemeCanvasBackground}">
                    <Grid>
                        <controls:WorksheetView x:Name="WorksheetCanvas"/>
                        <md:MarkdownWorkspaceControl x:Name="CenterMarkdownWorkspace"
                                                     Visibility="Collapsed"
                                                     ShowApplyButton="True"
                                                     ApplyButtonLabel="✅ Aplicar Cambios Markdown a la Evaluación"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Column 4: Right Splitter -->
            <GridSplitter Grid.Column="4" x:Name="RightGridSplitter" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ThemeBorder}" Cursor="SizeWE">
                <GridSplitter.Template>
                    <ControlTemplate>
                        <Border Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,0,1,0">
                            <TextBlock Text="⋮" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ================= COLUMN 5: RIGHT SIDEBAR (ASISTENTE IA / MINIATURAS) ================= -->
            <Border Grid.Column="5" x:Name="RightSidebarBorder" Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Row 0: Prominent Header with Mode Switcher & Close Button -->
                        <RowDefinition Height="*"/>      <!-- Row 1: Content: AiAssistantPane or ThumbnailsPane -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Right Sidebar Header (Tabs + Ocultar ▶ Button) -->
                    <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6,8,6">
                        <DockPanel LastChildFill="False">
                            <Border DockPanel.Dock="Left" Background="{DynamicResource ThemeControlBackground}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="5" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TabAsistente" Style="{StaticResource SegmentedRadioBtn}" Content="🤖 Asistente IA" FontSize="13" Padding="10,4"
                                                 GroupName="RightTabs" IsChecked="True" Checked="OnRightTabChanged"/>
                                    <RadioButton x:Name="TabMiniatura" Style="{StaticResource SegmentedRadioBtn}" Content="📄 Miniaturas" FontSize="13" Padding="10,4"
                                                 GroupName="RightTabs" Checked="OnRightTabChanged"/>
                                </StackPanel>
                            </Border>

                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolBtn}" Command="{Binding ToggleRightSidebarCommand}"
                                    ToolTip="Ocultar ventana lateral derecha (Asistente IA y Miniaturas)" Padding="8,2" MinHeight="28">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ocultar " FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="▶" FontSize="11.5" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- Row 1: Content Viewers -->
                    <Grid Grid.Row="1">
                        <controls:AiAssistantControl x:Name="AiAssistantPane" Visibility="Visible"/>
                        <controls:PageThumbnailsControl x:Name="ThumbnailsPane" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= COLUMN 6: COLLAPSED RIGHT DOCK STRIP ================= -->
            <Border Grid.Column="6" x:Name="RightCollapsedStrip" Visibility="Collapsed"
                    Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,0,0,0" Padding="4,8">
                <Button Style="{StaticResource ToolBtn}" Command="{Binding ToggleRightSidebarCommand}"
                        ToolTip="Abrir Panel Lateral de Asistente IA y Miniaturas" Padding="6,12" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="◀" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="I&#x0a;A&#x0a;&#x0a;Y&#x0a;&#x0a;P&#x0a;Á&#x0a;G" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
    </DockPanel>
</Window>
