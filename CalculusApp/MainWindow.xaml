                <MenuItem Header="🎓 Activar Edición Estudiante" Command="{Binding SwitchEditionCommand}" CommandParameter="student" Visibility="{Binding StudentEditionMenuVisibility}"/>
                <MenuItem Header="👨‍🏫 Activar Edición Profesor" Command="{Binding SwitchEditionCommand}" CommandParameter="teacher" Visibility="{Binding TeacherEditionMenuVisibility}"/>
                <MenuItem Header="🏛️ Activar Edición Instituto" Command="{Binding SwitchEditionCommand}" CommandParameter="institute" Visibility="{Binding InstituteEditionMenuVisibility}"/>
                <Separator/>
                <!-- Herramientas exclusivas de Edición Estudiante -->
                <MenuItem Header="📝 Auto-Prueba de Diagnóstico..." Command="{Binding StudentSelfTestCommand}" Visibility="{Binding StudentTabVisibility}"/>
                <MenuItem Header="📖 Resumen Teórico de Tema..." Command="{Binding StudentSummaryCommand}" Visibility="{Binding StudentTabVisibility}"/>
                <MenuItem Header="⏱️ Mi Horario de Estudio..." Command="{Binding StudentScheduleCommand}" Visibility="{Binding StudentTabVisibility}"/>
                <MenuItem Header="🎯 Ruta de Compensación de Fallas..." Command="{Binding StudentStudyRouteCommand}" Visibility="{Binding StudentTabVisibility}"/>
                <!-- Herramientas de Edición Profesor / Instituto -->
                <MenuItem Header="📋 Gestión de Nómina de Alumnos..." Command="{Binding TeacherRosterCommand}" Visibility="{Binding TeacherOrInstituteVisibility}"/>
                <MenuItem Header="🌐 Generar Examen Web para Nómina..." Command="{Binding TeacherWebExamCommand}" Visibility="{Binding TeacherOrInstituteVisibility}"/>
                <MenuItem Header="📅 Horario Docente y Entregas..." Command="{Binding TeacherScheduleCommand}" Visibility="{Binding TeacherOrInstituteVisibility}"/>
                <MenuItem Header="📑 Extractor de Ejercicios desde PDFs..." Command="{Binding TeacherPdfExtractorCommand}" Visibility="{Binding TeacherOrInstituteVisibility}"/>
                <MenuItem Header="📚 PDF Extractor Avanzado..." Command="{Binding TeacherPdfExtractorAdvancedCommand}" Visibility="{Binding TeacherOrInstituteVisibility}"/>
                <!-- Herramientas exclusivas de Edición Instituto -->
                <Separator Visibility="{Binding InstituteTabVisibility}"/>
                <MenuItem Header="🏛️ Claustro Docente y Departamentos..." Command="{Binding InstituteFacultyCommand}" Visibility="{Binding InstituteTabVisibility}"/>
                <MenuItem Header="📚 Coordinación Multi-Materia..." Command="{Binding InstituteMultiSubjectCommand}" Visibility="{Binding InstituteTabVisibility}"/>
                <MenuItem Header="🌐 Examen Institucional Centralizado..." Command="{Binding InstituteCentralWebExamsCommand}" Visibility="{Binding InstituteTabVisibility}"/>
            </MenuItem>

            <MenuItem Header="{Binding [menu_edit]}">
                <MenuItem Header="{Binding [menu_undo]}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="{Binding [menu_redo]}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="{Binding [menu_regen_all]}" Command="{Binding RegenerateAllCommand}" InputGestureText="F5"/>
                <MenuItem Header="{Binding [menu_scramble_q]}" Command="{Binding ScrambleQuestionsCommand}"/>
                <MenuItem Header="{Binding [menu_scramble_a]}" Command="{Binding ScrambleChoicesCommand}"/>
            </MenuItem>

            <MenuItem Header="{Binding [menu_view]}">
                <MenuItem Header="◧ Mostrar Panel Izquierdo (Temas y Series)" IsCheckable="True" IsChecked="{Binding IsLeftSidebarOpen, Mode=TwoWay}"/>
                <MenuItem Header="◨ Mostrar Panel Derecho (Asistente IA y Miniaturas)" IsCheckable="True" IsChecked="{Binding IsRightSidebarOpen, Mode=TwoWay}"/>
