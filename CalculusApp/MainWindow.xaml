<Window x:Class="CalculusApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CalculusApp"
        xmlns:controls="clr-namespace:CalculusApp.Controls"
        xmlns:md="clr-namespace:CalculusApp.Markdown.Controls;assembly=CalculusApp.Markdown"
        xmlns:vm="clr-namespace:CalculusApp.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="900" Width="1440"
        MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        FontSize="14"
        Background="{DynamicResource ThemeWindowBackground}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel LastChildFill="True">

        <!-- ================= 1. WINDOW TOP BAR (ELIDA MATH STUDIO + SELECTOR DE EDICIÓN + PANELES + SALIR) ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="12,6,12,6">
            <DockPanel LastChildFill="False">
                <!-- Left: Brand & Active Document Title -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="📐 " FontSize="17" VerticalAlignment="Center"/>
                    <TextBlock Text="ELIDA MATH STUDIO 2025" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  " Foreground="{DynamicResource ThemeTextMuted}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding WindowTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Edition Selector, Lateral Panel Toggles, Ribbon Mode, Theme & Exit -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Prominent Edition Selector (Estudiante | Profesor | Instituto) -->
                    <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="5" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center"
                            ToolTip="Seleccionar la Edición activa del sistema (filtra las pantallas y herramientas según la distribución)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎓 EDICIÓN:" FontSize="12" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AvailableEditions}"
                                      SelectedItem="{Binding ActiveEdition}"
                                      MinWidth="165" Height="26" FontSize="13" FontWeight="Bold"
                                      Background="Transparent" BorderThickness="0" VerticalAlignment="Center" VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="13.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Quick Toggle Left Sidebar (Temas) -->
                    <ToggleButton Style="{StaticResource ToggleToolBtn}" IsChecked="{Binding IsLeftSidebarOpen, Mode=TwoWay}"
                                  ToolTip="Mostrar u ocultar el panel lateral izquierdo (Temas y Series)" Margin="2,0" Padding="10,4" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◧ " FontSize="13.5"/>
                            <TextBlock Text="Panel Temas" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Quick Toggle Right Sidebar (Asistente IA / Miniaturas) -->
                    <ToggleButton Style="{StaticResource ToggleToolBtn}" IsChecked="{Binding IsRightSidebarOpen, Mode=TwoWay}"
                                  ToolTip="Mostrar u ocultar el panel lateral derecho (Asistente IA y Miniaturas)" Margin="2,0,8,0" Padding="10,4" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◨ " FontSize="13.5"/>
                            <TextBlock Text="Panel Asistente" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Ribbon / Menu Mode Switcher -->
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding ToggleRibbonModeCommand}" ToolTip="Alternar Modo con Ribbon / Modo sin Ribbon (Menú clásico)" Margin="2,0" Padding="10,4" MinHeight="30">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎛️ " FontSize="13"/>
                            <TextBlock Text="{Binding RibbonModeButtonText}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Quick Theme Toggle -->
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding ToggleThemeCommand}" ToolTip="Cambiar Tema (Claro / Oscuro)" Margin="2,0" Padding="10,4" MinHeight="30">
                        <TextBlock Text="{Binding ThemeStatusText}" FontSize="13" FontWeight="SemiBold"/>
                    </Button>

                    <!-- Salir Button -->
                    <Button Style="{StaticResource ToolBtn}" Click="OnMenuExitClick" ToolTip="Cerrar la Aplicación" Margin="6,0,0,0" Padding="10,4" MinHeight="30">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏻ " FontSize="14.5" Foreground="#EF4444" FontWeight="Bold"/>
                            <TextBlock Text="Salir" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 2. RIBBON (MODO CON RIBBON) ================= -->
        <Border DockPanel.Dock="Top" Visibility="{Binding RibbonVisibility}" Background="{DynamicResource ThemeRibbonBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Ribbon Tab Headers -->
                    <RowDefinition Height="Auto"/>  <!-- Ribbon Active Tab Content -->
                </Grid.RowDefinitions>

                <!-- 2a. Ribbon Tab Headers (Filtered by Active Edition) -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeRibbonTabBackground}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="0,0,0,1" Padding="8,3,8,0">
                    <DockPanel LastChildFill="True">
                        <!-- Active Subject Badge on Right -->
                        <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,4,3"
                                Background="{DynamicResource ThemeControlBackground}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="10,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="MATERIA ACTIVA: " FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentSubject.Icon}" FontSize="13" Margin="2,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentSubject.Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource RibbonTabRadioBtn}" GroupName="RibbonTabs" Content="📐 MATEMÁTICA AVANZADA" FontSize="13.5" Padding="15,7" IsChecked="{Binding IsMatematicaTabActive, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource RibbonTabRadioBtn}" GroupName="RibbonTabs" Content="🎛️ PANEL DE CONTROL" FontSize="13.5" Padding="15,7" IsChecked="{Binding IsPanelControlTabActive, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource RibbonTabRadioBtn}" GroupName="RibbonTabs" Content="📝 DISEÑO DE EVALUACIONES" FontSize="13.5" Padding="15,7" IsChecked="{Binding IsDisenoTabActive, Mode=TwoWay}"/>

                            <!-- Pestañas filtradas dinámicamente según la Edición seleccionada -->
                            <RadioButton Style="{StaticResource RibbonTabRadioBtn}" GroupName="RibbonTabs" Content="🎓 MÓDULO ESTUDIANTE" FontSize="13.5" Padding="15,7"
                                         IsChecked="{Binding IsEstudianteTabActive, Mode=TwoWay}" Visibility="{Binding StudentTabVisibility}"/>
                            <RadioButton Style="{StaticResource RibbonTabRadioBtn}" GroupName="RibbonTabs" Content="👨‍🏫 MÓDULO PROFESOR" FontSize="13.5" Padding="15,7"
                                         IsChecked="{Binding IsProfesorTabActive, Mode=TwoWay}" Visibility="{Binding TeacherTabVisibility}"/>
                            <RadioButton Style="{StaticResource RibbonTabRadioBtn}" GroupName="RibbonTabs" Content="🏛️ MÓDULO INSTITUTO" FontSize="13.5" Padding="15,7"
                                         IsChecked="{Binding IsInstitutoTabActive, Mode=TwoWay}" Visibility="{Binding InstituteTabVisibility}"/>

                            <RadioButton Style="{StaticResource RibbonTabRadioBtn}" GroupName="RibbonTabs" Content="🔧 HERRAMIENTAS Y VISTA" FontSize="13.5" Padding="15,7" IsChecked="{Binding IsHerramientasTabActive, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource RibbonTabRadioBtn}" GroupName="RibbonTabs" Content="ℹ️ AYUDA" FontSize="13.5" Padding="15,7" IsChecked="{Binding IsAyudaTabActive, Mode=TwoWay}"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <!-- 2b. Ribbon Body Content (Active Tab with Larger Buttons & Fonts) -->
                <Border Grid.Row="1" Padding="10,6,10,6" MinHeight="76">
                    <Grid>
                        <!-- Tab Content 1: MATEMÁTICA AVANZADA -->
                        <DockPanel LastChildFill="False">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatematicaTabActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <!-- Group 1: Asignaturas / Materias -->
                                <ItemsControl ItemsSource="{Binding AvailableSubjects}" Margin="0,0,10,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RibbonSubjectBtn}"
                                                    Command="{Binding DataContext.SelectSubjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}"
                                                    MinWidth="135" Height="33" Margin="2" Padding="10,4" FontSize="13.2" FontWeight="SemiBold">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}" FontSize="13.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Style="{StaticResource ToolSep}" Height="58" Margin="6,0,10,0"/>

                                <!-- Group 2: Acciones de Documento -->
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding NewCommand}" ToolTip="Nuevo Documento (Ctrl+N)" MinWidth="68" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📄" FontSize="19" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Nuevo" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding OpenCommand}" ToolTip="Abrir Documento (Ctrl+O)" MinWidth="68" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📂" FontSize="19" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Abrir" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding SaveCommand}" ToolTip="Guardar Documento (Ctrl+S)" MinWidth="72" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="19" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Guardar" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ExportPdfCommand}" ToolTip="Exportar a PDF (Ctrl+E)" MinWidth="74" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Background="#E11D48" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="PDF" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="Exportar PDF" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding PreviewPdfCommand}" ToolTip="Vista Previa de Impresión" MinWidth="74" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🖨️" FontSize="19" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Vista Previa" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Separator Style="{StaticResource ToolSep}" Height="58" Margin="8,0,8,0"/>

                                <!-- Group 3: Markdown (.md) -->
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding OpenMarkdownStudioCommand}" ToolTip="Manipular, Editar y Guardar Evaluación en Formato Markdown (.md)" MinWidth="92" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📝" FontSize="19" Foreground="#7C3AED" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Estudio .md" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ExportMarkdownCommand}" ToolTip="Guardar Evaluación Directamente como Archivo Markdown (.md)" MinWidth="88" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="19" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Guardar .md" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Group 4: Herramientas de Banco INI (Filtradas para Profesor / Instituto) -->
                                <Separator Style="{StaticResource ToolSep}" Height="58" Margin="8,0,8,0" Visibility="{Binding TeacherOrInstituteVisibility}"/>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ExportIniCommand}" Visibility="{Binding TeacherOrInstituteVisibility}"
                                        ToolTip="Exportar Banco de Ejercicios en Formato Plano (.ini / .txt)" MinWidth="82" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Banco .ini" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding LoadSyllabusFileCommand}" Visibility="{Binding TeacherOrInstituteVisibility}"
                                        ToolTip="Cargar Temario Externo (.ini / .txt)" MinWidth="92" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⚙️" FontSize="18" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Temario .ini" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Tab Content 2: PANEL DE CONTROL -->
                        <DockPanel LastChildFill="False">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPanelControlTabActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding RegenerateAllCommand}" ToolTip="Regenerar Todos los Ejercicios (F5)" MinWidth="105" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔄" FontSize="19" Foreground="#10B981" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Regenerar Todo" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ToggleAnswersCommand}" ToolTip="Mostrar u Ocultar Respuestas" MinWidth="110" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="👁️" FontSize="19" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Ver Respuestas" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Separator Style="{StaticResource ToolSep}" Height="58" Margin="8,0,8,0"/>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ToggleLeftSidebarCommand}" ToolTip="Abrir o cerrar la ventana lateral de Temas y Series" MinWidth="115" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="◧" FontSize="19" Foreground="#7C3AED" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LeftSidebarToggleText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ToggleRightSidebarCommand}" ToolTip="Abrir o cerrar la ventana lateral del Asistente IA y Miniaturas" MinWidth="125" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="◨" FontSize="19" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RightSidebarToggleText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Separator Style="{StaticResource ToolSep}" Height="58" Margin="8,0,8,0" Visibility="{Binding TeacherOrInstituteVisibility}"/>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding LoadSyllabusFileCommand}" Visibility="{Binding TeacherOrInstituteVisibility}"
                                        ToolTip="Cargar Archivo de Temario (.ini / .txt)" MinWidth="105" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📂" FontSize="19" Foreground="#007ACC" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Cargar .ini" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Tab Content 3: DISEÑO DE EVALUACIONES -->
                        <DockPanel LastChildFill="False">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDisenoTabActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ChangeAllToMultipleChoiceCommand}" ToolTip="Convertir Todo a Opción Múltiple" MinWidth="115" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔘" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Opción Múltiple" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ChangeAllToFreeResponseCommand}" ToolTip="Convertir Todo a Respuesta Libre" MinWidth="115" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="✍️" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Respuesta Libre" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Separator Style="{StaticResource ToolSep}" Height="58" Margin="8,0,8,0"/>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ScrambleQuestionsCommand}" ToolTip="Mezclar el Orden de las Preguntas" MinWidth="115" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔀" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Mezclar Preguntas" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ScrambleChoicesCommand}" ToolTip="Mezclar Opciones A, B, C, D" MinWidth="115" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🎲" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Mezclar Opciones" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Separator Style="{StaticResource ToolSep}" Height="58" Margin="8,0,8,0"/>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding RespaceWithinPageCommand}" ToolTip="Distribuir Espacio Uniforme en la Página" MinWidth="110" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="↔️" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Espaciar Página" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Separator Style="{StaticResource ToolSep}" Height="58" Margin="8,0,8,0"/>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding OpenMarkdownStudioCommand}" ToolTip="Abrir Estudio de Manipulación y Edición Markdown (.md) de la Evaluación" MinWidth="110" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📝" FontSize="18" Foreground="#7C3AED" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Editor .md" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ImportMarkdownCommand}" ToolTip="Abrir o Importar Evaluación desde Archivo Markdown (.md)" MinWidth="100" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📂" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Abrir .md" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding ExportMarkdownCommand}" ToolTip="Guardar Evaluación como Archivo Markdown (.md)" MinWidth="100" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="18" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Guardar .md" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Tab Content: ESTUDIANTE (Visible solo en Edición Estudiante) -->
                        <DockPanel LastChildFill="False">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEstudianteTabActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding StudentSelfTestCommand}" ToolTip="Generar Auto-Prueba de Diagnóstico" MinWidth="125" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📝" FontSize="19" Foreground="#10B981" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Auto-Prueba" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionBtn}" Command="{Binding StudentSummaryCommand}" ToolTip="Resumen Teórico del Tema Seleccionado" MinWidth="125" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📖" FontSize="19" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Resumen del Tema" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
